{
  "name": "@leyemeta/openclaw-channel",
  "version": "0.0.1-alpha.0",
  "description": "OpenClaw Channel plugin for the leyemeta platform.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": ["./src/index.ts"],
    "runtimeExtensions": ["./dist/index.js"],
    "channel": {
      "id": "leyemeta",
      "label": "leyemeta",
      "selectionLabel": "乐椰星球",
      "docsPath": "/channels/leyemeta",
      "docsLabel": "leyemeta",
      "blurb": "把 乐椰星球 平台智能体接入 OpenClaw",
      "order": 60,
      "quickstartAllowFrom": false
    },
    "compat": {
      "pluginApi": ">=2026.5.0"
    }
  },
   "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
